    "test:render": "tsx --test --test-force-exit src/modules/render/__tests__/splice-render.test.ts src/modules/render/__tests__/conform-render.test.ts src/modules/render/__tests__/render-parity.test.ts src/modules/render/__tests__/sequence-render.test.ts src/modules/render/__tests__/layers-render.test.ts src/modules/templates/__tests__/templates-render.test.ts src/modules/render/__tests__/output-frames-render.test.ts src/modules/publishing/__tests__/publication-render.test.ts"
  },
  "dependencies": {
