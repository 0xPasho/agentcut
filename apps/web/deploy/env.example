# ~/agentcut/.env on the box: the only file with a secret in it, never in git. The bundle
# reads it on boot (node's loadEnvFile), and `node --env-file=.env dist/migrate.mjs` uses
# the same file. After editing: pm2 restart agentcut-web --update-env
#
# The password is AGENTCUT_APP_PASSWORD in the credentials file on the deploy box, beside
# the other apps' roles. The role is agentcut_app and it owns the database agentcut on the
# owner's Postgres host — the one postgun's DATABASE_URL points at.
DATABASE_URL=postgresql://agentcut_app:PASSWORD@DB_HOST:5432/agentcut

# The port nginx proxies to. Keep it in step with deploy/nginx.conf and ecosystem.config.cjs.
PORT=3013

# Clerk's production instance, with GitHub as its only social connection. Without the
# pair, the site runs anonymous: browsing, searching and installing work, and /login says
# sign-in is not configured. Submitting a pack is the only thing that needs an account.
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
