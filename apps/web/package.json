{
  "name": "@agentcut/web",
  "version": "0.0.0",
  "private": true,
  "description": "agentcut.dev: the landing page and the packs marketplace, on Cloudflare Workers with Postgres through Hyperdrive, and Clerk for accounts.",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/styles.css --minify",
    "dev": "pnpm build:css && node scripts/dev.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "seed:local": "node scripts/seed-local.mjs",
    "test": "pnpm build:css && node --test --test-concurrency=1 test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm build:css && wrangler deploy"
  },
  "dependencies": {
    "@agentcut/core": "workspace:*",
    "@clerk/backend": "^3.23.2",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@electric-sql/pglite": "^0.5.9",
    "@electric-sql/pglite-socket": "^0.2.12",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "wrangler": "^4.148.0"
  }
}
