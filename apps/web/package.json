{
  "name": "@agentcut/web",
  "version": "0.0.0",
  "private": true,
  "description": "agentcut.dev: the landing page and the packs marketplace, on Cloudflare Workers (D1 + R2).",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/styles.css --minify",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "dev": "pnpm build:css && pnpm db:migrate:local && wrangler dev --port 8787 --var DEV_LOGIN:1",
    "seed:local": "node scripts/seed-local.mjs",
    "test": "pnpm build:css && node --test --test-concurrency=1 test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm build:css && wrangler deploy"
  },
  "dependencies": {
    "@agentcut/core": "workspace:*",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "wrangler": "^4.148.0"
  }
}
