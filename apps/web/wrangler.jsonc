// agentcut.dev: the landing page and the packs marketplace.
// Local dev runs the worker and its D1 in miniflare: `pnpm dev`. A pack's files are never
// stored here; they stay in the GitHub repository the pack is registered from.
// Accounts are Clerk's. Set with `wrangler secret put <NAME>`, never committed:
//   CLERK_SECRET_KEY       Clerk's backend key. Without it, nobody can sign in, and
//                          submitting a pack is the only thing that needs an account.
//   CLERK_PUBLISHABLE_KEY  Clerk's frontend key, which the session handshake needs.
// For local dev, put them in apps/web/.dev.vars (gitignored) to try the real sign-in.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentcut-web",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    // "1" signs every visitor in as a local identity, so a checkout never asks anybody to
    // sign in. Never "1" in production.
    "DEV_LOGIN": "0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentcut-web",
      // Replace with the id `wrangler d1 create agentcut-web` prints before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
